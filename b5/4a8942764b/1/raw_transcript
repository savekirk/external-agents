es), Entries: entries, ModifiedFiles: uniqueModifiedFiles(entries)}\n+\t}\n+\n+\tvar raw any\n+\tif err := json.Unmarshal(trimmed, &raw); err != nil {\n+\t\tentries := readEntries(data)\n+\t\treturn transcriptData{ThreadID: firstEntryThreadID(entries), Entries: entries, ModifiedFiles: uniqueModifiedFiles(entries)}\n+\t}\n+\tmessages := findThreadMessages(raw)\n+\treturn transcriptData{\n+\t\tThreadID:      findThreadID(raw),\n+\t\tMessages:      messages,\n+\t\tModifiedFiles: extractModifiedFilesFromMessages(messages),\n+\t\tPrepared:      true,\n+\t}\n+}\n+\n+func firstEntryThreadID(entries []ampTranscriptEntry) string {\n+\tfor _, entry := range entries {\n+\t\tif entry.ThreadID != \"\" {\n+\t\t\treturn entry.ThreadID\n+\t\t}\n+\t}\n+\treturn \"\"\n+}\n+\n+func findThreadID(v any) string {\n+\tswitch value := v.(type) {\n+\tcase map[string]any:\n+\t\tfor _, key := range []string{\"thread_id\", \"threadID\", \"threadId\", \"id\"} {\n+\t\t\tif s, ok := value[key].(string); ok && strings.HasPrefix(s, \"T-\") {\n+\t\t\t\treturn s\n+\t\t\t}\n+\t\t}\n+\t\tfor _, key := range []string{\"thread\", \"data\"} {\n+\t\t\tif id := findThreadID(value[key]); id != \"\" {\n+\t\t\t\treturn id\n+\t\t\t}\n+\t\t}\n+\t\tfor _, child := range value {\n+\t\t\tif id := findThreadID(child); id != \"\" {\n+\t\t\t\treturn id\n+\t\t\t}\n+\t\t}\n+\tcase []any:\n+\t\tfor _, child := range value {\n+\t\t\tif id := findThreadID(child); id != \"\" {\n+\t\t\t\treturn id\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn \"\"\n+}\n+\n+func findThreadMessages(v any) []threadMessage {\n+\tswitch value := v.(type) {\n+\tcase map[string]any:\n+\t\tfor _, key := range []string{\"messages\", \"threadMessages\"} {\n+\t\t\tif messages := decodeThreadMessages(value[key]); len(messages) > 0 {\n+\t\t\t\treturn messages\n+\t\t\t}\n+\t\t}\n+\t\tfor _, key := range []string{\"thread\", \"data\"} {\n+\t\t\tif messages := findThreadMessages(value[key]); len(messages) > 0 {\n+\t\t\t\treturn messages\n+\t\t\t}\n+\t\t}\n+\t\tfor _, 