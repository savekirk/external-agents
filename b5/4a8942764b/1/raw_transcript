", f, files)\n601: \t\t}\n602: \t}\n603: }\n604: \n605: func TestDeepBranching_ExtractPrompts(t *testing.T) {\n606: \tpath := writeJSONL(t, \"deep.jsonl\", testDeepBranchingJSONL)\n607: \tagent := New()\n608: \n609: \tprompts, err := agent.ExtractPrompts(path, 0)\n610: \tif err != nil {\n611: \t\tt.Fatal(err)\n612: \t}\n613: \t// m1 and m5 are both on the active branch.\n614: \tif len(prompts) != 2 {\n615: \t\tt.Fatalf(\"prompts = %v, want 2 entries\", prompts)\n616: \t}\n617: \tif prompts[0] != \"make files\" || prompts[1] != \"try b instead\" {\n618: \t\tt.Errorf(\"prompts = %v\", prompts)\n619: \t}\n620: }\n621: \n622: func TestDeepBranching_Summary(t *testing.T) {\n623: \tpath := writeJSONL(t, \"deep.jsonl\", testDeepBranchingJSONL)\n624: \tagent := New()\n625: \n626: \tsummary, has, err := agent.ExtractSummary(path)\n627: \tif err != nil {\n628: \t\tt.Fatal(err)\n629: \t}\n630: \tif !has || summary != \"done c\" {\n631: \t\tt.Errorf(\"summary = %q, want %q\", summary, \"done c\")\n632: \t}\n633: }\n634: \n635: func TestDeepBranching_Tokens(t *testing.T) {\n636: \tagent := New()\n637: \tusage, err := agent.CalculateTokens([]byte(testDeepBranchingJSONL), 0)\n638: \tif err != nil {\n639: \t\tt.Fatal(err)\n640: \t}\n641: \t// Active assistant messages: m2(10,5), m9(20,10), m11(20,10) = input:50, output:25\n642: \t// Abandoned: m4(10,5), m6(10,5), m8(10,5)\n643: \tif usage.InputTokens != 50 {\n644: \t\tt.Errorf(\"InputTokens = %d, want 50\", usage.InputTokens)\n645: \t}\n646: \tif usage.OutputTokens != 25 {\n647: \t\tt.Errorf(\"OutputTokens = %d, want 25\", usage.OutputTokens)\n648: \t}\n649: \tif usage.APICallCount != 3 {\n650: \t\tt.Errorf(\"APICallCount = %d, want 3\", usage.APICallCount)\n651: \t}\n652: }\n653: \n654: // ---------------------------------------------------------------------------\n655: // Multi-fork: 3 branches from the same parent\n656: // ---------------------------------------------------------------------------\n657: \n658: const testMultiFor