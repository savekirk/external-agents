 branch rewind:\n90: // agent creates file A → snapshot rewind points → agent creates file B → rewind → file A exists, file B gone.\n91: // No commits happen — this tests pure shadow branch rewind points.\n92: func TestLifecycle_RewindPreCommit(t *testing.T) {\n93: \ttestutil.ForEachAgent(t, 3*time.Minute, func(t *testing.T, s *testutil.RepoState, ctx context.Context) {\n94: \t\t// Agent creates file A (no commit).\n95: \t\t_, err := s.RunPrompt(t, ctx, \"Create a file called alpha.txt with content 'alpha'. Do not commit the file. Do not ask for confirmation.\")\n96: \t\trequire.NoError(t, err, \"first prompt failed\")\n97: \t\ttestutil.AssertFileExists(t, s.Dir, \"alpha.txt\")\n98: \n99: \t\t// Snapshot rewind points (shadow branch, is_logs_only=false).\n100: \t\tpoints := entire.RewindList(t, s.Dir)\n101: \t\trequire.NotEmpty(t, points, \"expected at least one rewind point after first prompt\")\n102: \t\trewindTarget := points[0].ID\n103: \n104: \t\t// Agent creates file B (no commit).\n105: \t\t_, err = s.RunPrompt(t, ctx, \"Create a file called beta.txt with content 'beta'. Do not commit the file. Do not ask for confirmation.\")\n106: \t\trequire.NoError(t, err, \"second prompt failed\")\n107: \t\ttestutil.AssertFileExists(t, s.Dir, \"beta.txt\")\n108: \n109: \t\t// Rewind to point after file A was created.\n110: \t\terr = entire.Rewind(t, s.Dir, rewindTarget)\n111: \t\trequire.NoError(t, err, \"rewind to %s should succeed\", rewindTarget)\n112: \n113: \t\t// File A should still exist, file B should be gone.\n114: \t\t_, err = os.Stat(filepath.Join(s.Dir, \"alpha.txt\"))\n115: \t\tassert.NoError(t, err, \"alpha.txt should exist after rewind\")\n116: \t\t_, err = os.Stat(filepath.Join(s.Dir, \"beta.txt\"))\n117: \t\tassert.True(t, os.IsNotExist(err), \"beta.txt should not exist after rewind\")\n118: \t})\n119: }\n120: \n121: // TestLifecycle_RewindAfterCommit verifies that pre-commit shadow branch\n122: // rewind points become invalid after a user commit. Rewinding to an old\n123: // shadow branch ID should fail because condensation converts them to logs-only.\n124: func TestLifecycle_RewindAfterCommit(t *testing.T) {\n125: \ttestutil.ForEachAgent(t, 3*time.Minute, func(t *testing.T, s *testutil.RepoState, ctx context.Context) {\n126: \t\t// Agent creates a file (no commit).\n127: \t\t_, err := s.RunPrompt(t, ctx, \"Create a file called first.txt with content 'first'. Do not commit the file. Do not ask for confirmation.\")\n128: \t\trequire.NoError(t, err, \"prompt failed\")\n129: \t\ttestutil.AssertFileExists(t, s.Dir, \"first.txt\")\n130: \n131: \t\t// Get pre-commit rewind points and find a non-logs-only shadow point.\n132: \t\tpointsBefore := entire.RewindList(t, s.Dir)\n133: \t\trequire.NotEmpty(t, pointsBefore, \"expected rewind points before commit\")\n134: \n135: \t\tvar shadowPoint *entire.RewindPoint\n136: \t\tfor i := range pointsBefore {\n137: \t\t\tif !pointsBefore[i].IsLogsOnly {\n138: \t\t\t\tshadowPoint = &pointsBefore[i]\n139: \t\t\t\tbreak\n140: \t\t\t}\n141: \t\t}\n142: \t\trequire.NotNil(t, shadowPoint, \"expected at least one non-logs-only shadow branch rewind point\")\n143: \t\toldID := shadowPoint.ID\n144: \n145: \t\t// User commits the file — triggers condensation.\n146: \t\ts.Git(t, \"add\", \".\")\n147: \t\ts.Git(t, \"commit\", \"-m\", \"add first.txt\")\n148: \t\ttestutil.WaitForCheckpoint(t, s, 30*time.Second)\n149: \n150: \t\t// Old shadow point should no longer be listed as non-logs-only.\n151: \t\tpointsAfter := entire.RewindList(t, s.Dir)\n152: \t\tfound := false\n153: \t\tfor _, p := range pointsAfter {\n154: \t\t\tif p.ID == oldID && !p.IsLogsOnly {\n155: \t\t\t\tfound = true\n156: \t\t\t\tbreak\n157: \t\t\t}\n158: \t\t}\n159: \t\tassert.False(t, found, \"old shadow branch rewind point %s should no longer be listed as non-logs-only\", oldID)\n160: \n161: \t\t// Attempting to rewind to the old shadow branch ID should fail.\n162: \t\terr = entire.Rewind(t, s.Dir, oldID)\n163: \t\tassert.Error(t, err, \"rewind to old shadow branch ID should fail after commit\")\n164: \n165: \t\t// Working directory should be unchanged — file still committed.\n166: \t\ttestutil.AssertFileExists(t, s.Dir, \"first.txt\")\n167: \t\ttestutil.AssertNoShadowBranches(t, s.Dir)\n168: \t})\n169: }\n170: \n171: // TestLifecycle_SessionPersistence verifies that a session file is created in\n172: // .entire/tmp/ after running a prompt.\n173: func TestLifecycle_SessionPersistence(t *testing.T) {\n174: \ttestutil.ForEachAgent(t, 2*time.Minute, func(t *testing.T, s *testutil.RepoState, ctx context.Context) {\n175: \t\t_, err := s.RunPrompt(t, ctx, \"Create a file called session-test.txt with content 'test'. Do not ask for confirmation.\")\n176: \t\trequire.NoError(t, err, \"prompt failed\")\n177: \n178: \t\ttmpDir := filepath.Join(s.Dir, \".entire\", \"tmp\")\n179: \t\tentries, err := os.ReadDir(tmpDir)\n180: \t\trequire.NoError(t, err, \"read .entire/tmp/\")\n181: \n182: \t\thasSession := false\n183: \t\tfor _, entry := range entries {\n184: \t\t\tif filepath.Ext(entry.Name()) == \".json\" {\n185: \t\t\t\thasSession = true\n186: \t\t\t\tbreak\n187: \t\t\t}\n188: \t\t}\n189: \t\tassert.True(t, hasSession, \"expected at least one .json session file in .entire/tmp/\")\n190: \t})\n191: }\n192: \n193: // TestLifecycle_InteractiveSession verifies that an interactive tmux session\n194: // can send prompts and receive responses.\n195: func TestLifecycle_InteractiveSession(t *testing.T) {\n196: \ttestutil.ForEachAgent(t, 3*time.Minute, func(t *testing.T, s *testutil.RepoState, ctx context.Context) {\n197: \t\tsession := s.StartSession(t, ctx)\n198: \t\tif session == nil {\n199: \t\t\tt.Skip(\"agent does not support interactive sessions\")\n200: \t\t}\n201: \n202: \t\ts.Send(t, session, \"Create a file called interactive.txt with 'hello'. Do not ask for confirmation.\")\n203: \t\ts.WaitFor(t, session, s.Agent.PromptPattern(), 60*time.Second)\n204: \n205: \t\ttestutil.WaitForFileExists(t, s.Dir, \"interactive.txt\", 10*time.Second)\n206: \n207: \t\ts.Git(t, \"add\", \".\")\n208: \t\ts.Git(t, \"commit\", \"-m\", \"interactive test\")\n209: \t\ttestutil.WaitForCheckpoint(t, s, 30*time.Second)\n210: \t})\n211: }\n212: \n213: func hooksInstalled(t *testing.T, binPath, repoRoot string) bool {\n214: \tt.Helper()\n215: \n216: \tcmd := exec.Command(binPath, \"are-hooks-installed\")\n217: \tcmd.Env = append(os.Environ(),\n218: \t\t\"ENTIRE_REPO_ROOT=\"+repoRoot,\n219: \t\t\"LANG=en_US.UTF-8\",\n220: \t)\n221: \n222: \tout, err := cmd.Output()\n223: \tif err != nil {\n224: \t\tif exitErr, ok := err.(*exec.ExitError); ok {\n225: \t\t\tt.Fatalf(\"%s are-hooks-installed failed: %v\\nstdout: %s\\nstderr: %s\", binPath, err, out, exitErr.Stderr)\n226: \t\t}\n227: \t\tt.Fatalf(\"%s are-hooks-installed failed: %v\\nstdout: %s\", binPath, err, out)\n228: \t}\n229: \n230: \tvar resp struct {\n231: \t\tInstalled bool `json:\"installed\"`\n232: \t}\n233: \tif err := json.Unmarshal(out, &resp); err != nil {\n234: \t\tt.Fatalf(\"parse are-hooks-installed response: %v\\nraw output: %s\", err, out)\n235: \t}\n236: \n237: \treturn resp.Installed\n238: }\n\n(End of file - total 238 lines)\n</content>",
