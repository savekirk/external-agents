ractPrompts(path, len(data)+100)\n195: \tif err != nil {\n196: \t\tt.Fatal(err)\n197: \t}\n198: \tif len(prompts) != 0 {\n199: \t\tt.Errorf(\"offset>len(data): got %d prompts, want 0\", len(prompts))\n200: \t}\n201: }\n202: \n203: func TestChunkAndReassemble(t *testing.T) {\n204: \tagent := New()\n205: \tdata := []byte(\"hello world, this is a test\")\n206: \n207: \tchunks, err := agent.ChunkTranscript(data, 10)\n208: \tif err != nil {\n209: \t\tt.Fatal(err)\n210: \t}\n211: \tif len(chunks) != 3 {\n212: \t\tt.Errorf(\"chunks = %d, want 3\", len(chunks))\n213: \t}\n214: \n215: \treassembled, err := agent.ReassembleTranscript(chunks)\n216: \tif err != nil {\n217: \t\tt.Fatal(err)\n218: \t}\n219: \tif string(reassembled) != string(data) {\n220: \t\tt.Errorf(\"reassembled = %q, want %q\", reassembled, data)\n221: \t}\n222: }\n223: \n224: func TestChunkTranscript_InvalidMaxSize(t *testing.T) {\n225: \tagent := New()\n226: \t_, err := agent.ChunkTranscript([]byte(\"test\"), 0)\n227: \tif err == nil {\n228: \t\tt.Error(\"expected error for max-size=0\")\n229: \t}\n230: }\n231: \n232: func TestReadSession(t *testing.T) {\n233: \tpath := writeTestSession(t)\n234: \tt.Setenv(\"ENTIRE_REPO_ROOT\", t.TempDir())\n235: \n236: \tagent := New()\n237: \tsession, err := agent.ReadSession(&protocol.HookInputJSON{\n238: \t\tSessionRef: path,\n239: \t})\n240: \tif err != nil {\n241: \t\tt.Fatal(err)\n242: \t}\n243: \n244: \tif session.SessionID != \"test-uuid-123\" {\n245: \t\tt.Errorf(\"SessionID = %q, want %q\", session.SessionID, \"test-uuid-123\")\n246: \t}\n247: \tif session.AgentName != \"pi\" {\n248: \t\tt.Errorf(\"AgentName = %q, want %q\", session.AgentName, \"pi\")\n249: \t}\n250: \tif session.StartTime != \"2026-03-27T21:00:00.000Z\" {\n251: \t\tt.Errorf(\"StartTime = %q\", session.StartTime)\n252: \t}\n253: \tif len(session.NativeData) == 0 {\n254: \t\tt.Error(\"NativeData should not be empty\")\n255: \t}\n256: \tif session.ModifiedFiles == nil {\n257: \t\tt.Error(\"ModifiedFiles must be initialized (not nil)\")\n258: \t}\n259: \tif session.NewFiles == nil {\n260: \t\tt.Error(\"NewFiles must be initialized (not nil)\")\n261: \t}\n262: \tif session.DeletedFiles == nil {\n263: \t\tt.Error(\"DeletedFiles must be initialized (not nil)\")\n264: \t}\n265: }\n266: \n267: func TestWriteSession(t *testing.T) {\n268: \tdir := t.TempDir()\n269: \tpath := filepath.Join(dir, \"session.json\")\n270: \n271: \tagent := New()\n272: \tdata := []byte(`{\"test\":\"data\"}`)\n273: \n274: \terr := agent.WriteSession(protocol.AgentSessionJSON{\n275: \t\tSessionRef: path,\n276: \t\tNativeData: data,\n277: \t})\n278: \tif err != nil {\n279: \t\tt.Fatal(err)\n280: \t}\n281: \n282: \tgot, err := os.ReadFile(path)\n283: \tif err != nil {\n284: \t\tt.Fatal(err)\n285: \t}\n286: \tif string(got) != string(data) {\n287: \t\tt.Errorf(\"got %q, want %q\", got, data)\n288: \t}\n289: }\n290: \n291: func writeJSONL(t *testing.T, name, content string) string {\n292: \tt.Helper()\n293: \tdir := t.TempDir()\n294: \tpath := filepath.Join(dir, name)\n295: \tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n296: \t\tt.Fatal(err)\n297: \t}\n298: \treturn path\n299: }\n300: \n301: func writeBranchingSession(t *testing.T) string {\n302: \tt.Helper()\n303: \tdir := t.TempDir()\n304: \tpath := filepath.Join(dir, \"2026-03-27T22-00-00-000Z_test-branch-123.jsonl\")\n305: \tif err := os.WriteFile(path, []byte(testBranchingSessionJSONL), 0o644); err != nil {\n306: \t\tt.Fatal(err)\n307: \t}\n308: \treturn path\n309: }\n310: \n311: func TestExtractModifiedFiles_Branching(t *testing.T) {\n312: \tpath := writeBranchingSession(t)\n313: \tagent := New()\n314: \n315: \tfiles, _, err := agent.ExtractModifiedFiles(path, 0)\n316: \tif err != nil {\n317: \t\tt.Fatal(err)\n318: \t}\n319: \t// Only new.txt (active branch), not old.txt (abandoned branch).\n320: \tif len(files) != 1 || files[0] != \"new.txt\" {\n321: \t\tt.Errorf(\"files = %v, want [new.txt]\", files)\n322: \t}\n323: }\n324: \n325: func TestExtractPrompts_Branching(t *testing.T) {\n326: \tpath := writeBranchingSession(t)\n327: \tagent := New()\n328: \n329: \tprompts, err := agent.ExtractPrompts(path, 0)\n330: \tif err != nil {\n331: \t\tt.Fatal(err)\n332: \t}\n333: \t// m1 is on the active branch.\n334: \tif len(prompts) != 1 || prompts[0] != \"Create a file\" {\n335: \t\tt.Errorf(\"prompts = %v, want [Create a file]\", prompts)\n336: \t}\n337: }\n338: \n339: func TestExtractSummary_Branching(t *testing.T) {\n340: \tpath := writeBranchingSession(t)\n341: \tagent := New()\n342: \n343: \tsummary, has, err := agent.ExtractSummary(path)\n344: \tif err != nil {\n345: \t\tt.Fatal(err)\n346: \t}\n347: \tif !has {\n348: \t\tt.Fatal(\"expected has_summary = true\")\n349: \t}\n350: \t// Active branch leaf, not abandoned branch.\n351: \tif summary != \"Created new.txt\" {\n352: \t\tt.Errorf(\"summary = %q, want %q\", summary, \"Created new.txt\")\n353: \t}\n354: }\n355: \n356: func TestCalculateTokens_Branching(t *testing.T) {\n357: \tdata := []byte(testBranchingSessionJSONL)\n358: \tagent := New()\n359: \n360: \tusage, err := agent.CalculateTokens(data, 0)\n361: \tif err != nil {\n362: \t\tt.Fatal(err)\n363: \t}\n364: \n365: \t// Only m5 (input=150,output=60) and m7 (input=250,output=40) on active branch.\n366: \tif usage.InputTokens != 400 {\n367: \t\tt.Errorf(\"InputTokens = %d, want 400\", usage.InputTokens)\n368: \t}\n369: \tif usage.OutputTokens != 100 {\n370: \t\tt.Errorf(\"OutputTokens = %d, want 100\", usage.OutputTokens)\n371: \t}\n372: \tif usage.CacheReadTokens != 5 {\n373: \t\tt.Errorf(\"CacheReadTokens = %d, want 5\", usage.CacheReadTokens)\n374: \t}\n375: \tif usage.CacheCreationTokens != 3 {\n376: \t\tt.Errorf(\"CacheCreationTokens = %d, want 3\", usage.CacheCreationTokens)\n377: \t}\n378: \tif usage.APICallCount != 2 {\n379: \t\tt.Errorf(\"APICallCount = %d, want 2\", usage.APICallCount)\n380: \t}\n381: }\n382: \n383: // ---------------------------------------------------------------------------\n384: // resolveActiveBranch unit tests\n385: // ---------------------------------------------------------------------------\n386: \n387: func TestResolveActiveBranch_LinearChain(t *testing.T) {\n388: \tdata := []byte(`{\"type\":\"session\",\"id\":\"s1\"}\n389: {\"type\":\"model_change\",\"id\":\"mc1\",\"parentId\":null}\n390: {\"type\":\"message\",\"id\":\"m1\",\"parentId\":\"mc1\"}\n391: {\"type\":\"message\",\"id\":\"m2\",\"parentId\":\"m1\"}\n392: {\"type\":\"message\",\"id\":\"m3\",\"parentId\":\"m2\"}\n393: `)\n394: \tactive := resolveActiveBranch(data)\n395: \tfor _, id := range []string{\"m3\", \"m2\", \"m1\", \"mc1\"} {\n396: \t\tif !active[id] {\n397: \t\t\tt.Errorf(\"expected %q in active set\", id)\n398: \t\t}\n399: \t}\n400: \t// session entry is not in the tree chain\n401: \tif active[\"s1\"] {\n402: \t\tt.Error(\"session entry should not be in active set\")\n403: \t}\n404: }\n405: \n406: func TestResolveActiveBranch_EmptyData(t *testing.T) {\n407: \tactive := resolveActiveBranch(nil)\n408: \tif active != nil {\n409: \t\tt.Errorf(\"expected nil for empty data, got %v\", active)\n410: \t}\n411: }\n412: \n413: func TestResolveActiveBranch_SessionOnly(t *testing.T) {\n414: \tdata := []byte(`{\"type\":\"session\",\"id\":\"s1\"}\n415: `)\n416: \tactive := resolveActiveBranch(data)\n417: \tif active != nil {\n418: \t\tt.Errorf(\"expected nil when no message entries, got %v\", active)\n419: \t}\n420: }\n421: \n422: func TestResolveActiveBranch_CycleProtection(t *testing.T) {\n423: \t// a → b → a (cycle). Should terminate, not infinite loop.\n424: \tdata := []byte(`{\"type\":\"message\",\"id\":\"a\",\"parentId\":\"b\"}\n425: {\"type\":\"message\",\"id\":\"b\",\"parentId\":\"a\"}\n426: `)\n427: \tactive := resolveActiveBranch(data)\n428: \t// Should contain both but not hang.\n429: \tif !active[\"a\"] || !active[\"b\"] {\n430: \t\tt.Errorf(\"active = %v, want both a and b\", active)\n431: \t}\n432: }\n433: \n434: func TestResolveActiveBranch_SelfReferentialParent(t *testing.T) {\n435: \tdata := []byte(`{\"type\":\"message\",\"id\":\"m1\",\"parentId\":\"m1\"}\n436: `)\n437: \tactive := resolveActiveBranch(data)\n438: \tif !active[\"m1\"] {\n439: \t\tt.Error(\"expected m1 in active set\")\n440: \t}\n441: \tif len(active) != 1 {\n442: \t\tt.Errorf(\"expected 1 entry in active set, got %d\", len(active))\n443: \t}\n444: }\n445: \n446: func TestResolveActiveBranch_TwoBranches_PicksLast(t *testing.T) {\n447: \t// Two branches from a: b (earlier) and c (later, last in file).\n448: \t// Active branch should be c's path.\n449: \tdata := []byte(`{\"type\":\"message\",\"id\":\"a\",\"parentId\":\"root\"}\n450: {\"type\":\"message\",\"id\":\"root\",\"parentId\":null}\n451: {\"type\":\"message\",\"id\":\"b\",\"parentId\":\"a\"}\n452: {\"type\":\"message\",\"id\":\"c\",\"parentId\":\"a\"}\n453: `)\n454: \n455: \tactive := resolveActiveBranch(data)\n456: \tif !active[\"c\"] || !active[\"a\"] {\n457: \t\tt.Errorf(\"expected c and a in active set, got %v\", active)\n458: \t}\n459: \tif active[\"b\"] {\n460: \t\tt.Error(\"b should not be in active set\")\n461: \t}\n462: }\n463: \n464: func TestResolveActiveBranch_FlatReturnsNil(t *testing.T) {\n465: \t// No parentId at all — should skip tree resolution.\n466: \tdata := []byte(`{\"type\":\"message\",\"id\":\"m1\"}\n467: {\"type\":\"message\",\"id\":\"m2\"}\n468: `)\n469: \tactive := resolveActiveBranch(data)\n470: \tif active != nil {\n471: \t\tt.Errorf(\"expected nil for flat transcript, got %v\", active)\n472: \t}\n473: }\n474: \n475: func TestResolveActiveBranch_NullParentIDOnly(t *testing.T) {\n476: \t// All entries have parentId:null — no real tree.\n477: \tdata := []byte(`{\"type\":\"message\",\"id\":\"m1\",\"parentId\":null}\n478: {\"type\":\"message\",\"id\":\"m2\",\"parentId\":null}\n479: `)\n480: \tactive := resolveActiveBranch(data)\n481: \tif active != nil {\n482: \t\tt.Errorf(\"expected nil when only null parentIds, got %v\", active)\n483: \t}\n484: }\n485: \n486: // ---------------------------------------------------------------------------\n487: // Deep tree: branch off a branch\n488: // ---------------------------------------------------------------------------\n489: // Trailing non-message entry: model_change after last message\n490: // ---------------------------------------------------------------------------\n491: \n492: func TestResolveActiveBranch_TrailingModelChange(t *testing.T) {\n493: \t// The last entry is a model_change, not a message.\n494: \t// resolveActiveBranch should use the last *message* as the leaf.\n495: \tdata := []byte(`{\"type\":\"message\",\"id\":\"m1\",\"parentId\":\"mc1\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}}\n496: {\"type\":\"message\",\"id\":\"mc1\",\"parentId\":null}\n497: {\"type\":\"message\",\"id\":\"m2\",\"parentId\":\"m1\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"hello\"}]}}\n498: {\"type\":\"model_change\",\"id\":\"mc2\",\"parentId\":\"m2\",\"provider\":\"anthropic\",\"modelId\":\"claude-opus-4-6\"}\n499: `)\n500: \tactive := resolveActiveBranch(data)\n501: \t// Active branch should be m2→m1→mc1, resolved from last message (m2), not from mc2.\n502: \tif !active[\"m2\"] || !active[\"m1\"] {\n503: \t\tt.Errorf(\"expected m2 and m1 in active set, got %v\", active)\n504: \t}\n505: }\n506: \n507: func TestTrailingModelChange_SummaryStillWorks(t *testing.T) {\n508: \tjsonl := `{\"type\":\"session\",\"id\":\"s1\"}\n509: {\"type\":\"model_change\",\"id\":\"mc1\",\"parentId\":null}\n510: {\"type\":\"message\",\"id\":\"m1\",\"parentId\":\"mc1\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}}\n511: {\"type\":\"message\",\"id\":\"m2\",\"parentId\":\"m1\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"hello\"}],\"usage\":{\"input\":10,\"output\":5,\"cacheRead\":0,\"cacheWrite\":0}}}\n512: {\"type\":\"model_change\",\"id\":\"mc2\",\"parentId\":\"m2\"}\n513: `\n514: \tpath := writeJSONL(t, \"trailing.jsonl\", jsonl)\n515: \tagent := New()\n516: \n517: \tsummary, has, err := agent.ExtractSummary(path)\n518: \tif err != nil {\n519: \t\tt.Fatal(err)\n520: \t}\n521: \tif !has || summary != \"hello\" {\n522: \t\tt.Errorf(\"summary = %q, want %q\", summary, \"hello\")\n523: \t}\n524: \n525: \tusage, err := agent.CalculateTokens([]byte(jsonl), 0)\n526: \tif err != nil {\n527: \t\tt.Fatal(err)\n528: \t}\n529: \tif usage.InputTokens != 10 || usage.OutputTokens != 5 {\n530: \t\tt.Errorf(\"tokens = %d/%d, want 10/5\", usage.InputTokens, usage.OutputTokens)\n531: \t}\n532: }\n533: \n534: // ---------------------------------------------------------------------------\n535: \n536: // testDeepBranchingJSONL:\n537: //\n538: //\tmc1 → m1(user) → m2(asst, write a.txt) → m3(result) → m4(asst \"done a\")\n539: //\t                                           └→ m5(user \"again\") → m6(asst, write b.txt) → m7(result) → m8(asst \"done b\")\n540: //\t                                                                   └→ m9(asst, write c.txt) → m10(result) → m11(asst \"done c\")\n541: //\n542: // Active branch: mc1 → m1 → m2 → m3 → m5 → m6 → m7 → m8 is NOT active\n543: // Wait, let me think again. The last message is m11. Walk up: m11→m10→m9→m5→m1→mc1.\n544: // So m6,m7,m8 are abandoned (branched from m5), and m2,m3,m4 are on the path (m3→m2→m1).\n545: // Wait no: m5.parentId=m3, so the chain is m11→m10→m9→m5... but m9.parentId=m5? No, I need\n546: // m9 to fork from m5 to create a deep branch. Let me design this more carefully.\n547: //\n548: // Tree:\n549: //\n550: //\tmc1(root)\n551: //\t  └→ m1(user, parentId=mc1)\n552: //\t       └→ m2(asst write a.txt, parentId=m1)\n553: //\t            └→ m3(toolResult, parentId=m2)\n554: //\t                 ├→ m4(asst \"done a\", parentId=m3) [abandoned]\n555: //\t                 └→ m5(user \"try b\", parentId=m3)\n556: //\t                      ├→ m6(asst write b.txt, parentId=m5) [abandoned]\n557: //\t                      │    └→ m7(toolResult, parentId=m6) [abandoned]\n558: //\t                      │         └→ m8(asst \"done b\", parentId=m7) [abandoned]\n559: //\t                      └→ m9(asst write c.txt, parentId=m5)  [active]\n560: //\t                           └→ m10(toolResult, parentId=m9)\n561: //\t                                └→ m11(asst \"done c\", parentId=m10)\n562: //\n563: // Active path: m11→m10→m9→m5→m3→m2→m1→mc1\n564: // Abandoned: m4, m6, m7, m8\n565: const testDeepBranchingJSONL = `{\"type\":\"session\",\"version\":3,\"id\":\"deep-123\",\"timestamp\":\"2026-03-28T00:00:00.000Z\",\"cwd\":\"/tmp\"}\n566: {\"type\":\"model_change\",\"id\":\"mc1\",\"parentId\":null}\n567: {\"type\":\"message\",\"id\":\"m1\",\"parentId\":\"mc1\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"make files\"}]}}\n568: {\"type\":\"message\",\"id\":\"m2\",\"parentId\":\"m1\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"toolCall\",\"id\":\"tc1\",\"name\":\"write\",\"arguments\":{\"path\":\"a.txt\",\"content\":\"a\"}}],\"usage\":{\"input\":10,\"output\":5,\"cacheRead\":0,\"cacheWrite\":0}}}\n569: {\"type\":\"message\",\"id\":\"m3\",\"parentId\":\"m2\",\"message\":{\"role\":\"toolResult\",\"toolCallId\":\"tc1\",\"toolName\":\"write\",\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]}}\n570: {\"type\":\"message\",\"id\":\"m4\",\"parentId\":\"m3\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"done a\"}],\"usage\":{\"input\":10,\"output\":5,\"cacheRead\":0,\"cacheWrite\":0}}}\n571: {\"type\":\"message\",\"id\":\"m5\",\"parentId\":\"m3\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"try b instead\"}]}}\n572: {\"type\":\"message\",\"id\":\"m6\",\"parentId\":\"m5\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"toolCall\",\"id\":\"tc2\",\"name\":\"write\",\"arguments\":{\"path\":\"b.txt\",\"content\":\"b\"}}],\"usage\":{\"input\":10,\"out