              "file": "agents/entire-agent-amp/.gitignore",
              "patch": "Index: agents/entire-agent-amp/.gitignore\n===================================================================\n--- agents/entire-agent-amp/.gitignore\t\n+++ agents/entire-agent-amp/.gitignore\t\n@@ -0,0 +1,2 @@\n+entire-agent-amp\n+.probe-amp-*\n",
