rr != nil \u0026\u0026 !os.IsNotExist(err) {\n130: \t\treturn err\n131: \t}\n132: \treturn nil\n133: }\n134: \n135: func (a *Agent) AreHooksInstalled() bool {\n136: \troot := protocol.RepoRoot()\n137: \tdata, err := os.ReadFile(filepath.Join(root, pluginFile))\n138: \treturn err == nil \u0026\u0026 strings.Contains(string(data), \"entire-agent-amp\")\n139: }\n140: \n141: func generatePlugin() string {\n142: \treturn `import type { PluginAPI, ThreadMessage } from \"@ampcode/plugin\";\n143: import { execFile } from \"node:child_process\";\n144: \n145: // entire-agent-amp: project-local Entire integration for Amp.\n146: export default function (amp: PluginAPI) {\n147:   const seenThreads = new Set\u003cstring\u003e();\n148: \n149:   function fireHook(hookName: string, data: Record\u003cstring, unknown\u003e): Promise\u003cvoid\u003e {\n150:     return new Promise((resolve) =\u003e {\n151:       try {\n152:         const child = execFile(\n153:           \"entire\",\n154:           [\"hooks\", \"amp\", hookName],\n155:           { timeout: 10000, windowsHide: true },\n156:           () =\u003e resolve(),\n157:         );\n158:         child.stdin?.end(JSON.stringify(data));\n159:       } catch {\n160:         resolve();\n161:       }\n162:     });\n163:   }\n164: \n165:   function modifiedFiles(messages: ThreadMessage[]): string[] {\n166:     const files = new Set\u003cstring\u003e();\n167:     for (const item of amp.helpers.toolCallsInMessages(messages)) {\n168:       for (const event of [item.call, item.result]) {\n169:         const modified = amp.helpers.filesModifiedByToolCall(event);\n170:         if (!modified) continue;\n171:         for (const file of modified) files.add(amp.helpers.filePathFromURI(file));\n172:       }\n173:     }\n174:     return Array.from(files).sort();\n175:   }\n176: \n177:   amp.on(\"agent.start\", async (event) =\u003e {\n178:     if (!seenThreads.has(event.thread.id)) {\n179:       seenThreads.add(event.thread.id);\n180:       await fi